# Local overrides. No API keys are required for the offline demo.
DATABASE_URL=postgresql+psycopg://worldstate:worldstate@localhost:5432/worldstate
NEXT_PUBLIC_API_URL=http://localhost:8000
# Comma-separated browser origins allowed to call the API. Localhost is always allowed.
# CORS_ORIGINS=https://web-production-def1f.up.railway.app

# Optional. The offline investigator does not call a model.
# OPENAI_API_KEY=

# Optional Graphiti connection. When this is set, each transaction step also calls
# https://github.com/getzep/graphiti add_episode. Install graphiti-core in that environment.
# GRAPHITI_URI=bolt://localhost:7687
# GRAPHITI_USER=neo4j
# GRAPHITI_PASSWORD=
