# Copy to .env for local overrides. Leave secrets empty.
# The shipping path is PHOTON_MODE=mock and EMAIL_MODE=sandbox.
# Those modes do not deliver iMessage or email.

DATABASE_URL=postgresql+psycopg://acme:acme@localhost:5432/procurement
APP_ENV=development
DEMO_MODE=true
DEMO_CLOCK=2026-10-24T15:00:00+00:00
SESSION_SECRET=dev-only-change-me
TOOL_API_TOKEN=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Photon / Spectrum. Mock is the only path exercised here.
# Live send needs a spectrum-ts session (space.send). There is no public HTTP send API.
# No project id, API key, or webhook secret was provided for this build.
PHOTON_MODE=mock
PHOTON_API_KEY=
PHOTON_PROJECT_ID=
PHOTON_WEBHOOK_SECRET=dev-webhook-secret
PHOTON_SENDER_ID=+15555551000
PHOTON_BASE_URL=

# Email. Sandbox writes a local ledger. SMTP is unused unless EMAIL_MODE=smtp and a host is set.
EMAIL_MODE=sandbox
EMAIL_WEBHOOK_SECRET=dev-email-secret
EMAIL_FROM=procurement@sandbox.acme.test
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# LLM. Deterministic extractors run when the key is absent.
LLM_MODE=deterministic
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini

MANAGER_APPROVAL_LIMIT=200000.00
QUOTE_FRESHNESS_DAYS=14
APPROVAL_TTL_HOURS=24
PSU_HEADROOM_W=200

EAGER_WORKER=true
WORKER_THREAD=false
SEED_ON_START=true
SEED_DEMO_TASK=true

NEXT_PUBLIC_API_URL=http://localhost:8000
