# Top-level Spectrum credentials (from your Photon dashboard).
PROJECT_ID=
PROJECT_SECRET=

# OpenRouter model used by the Deep Agents harness. The key stays here or in the host environment, never in source.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-6-astra

# Self-hosted Supermemory. One namespace per sender. Leave blank to run without it.
SUPERMEMORY_BASE_URL=
SUPERMEMORY_API_KEY=
