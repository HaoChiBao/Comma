#!/usr/bin/env bash
# Restore Acme and Beta fixtures, including the seeded demo request.
# Uses the Compose API container when it is running. Otherwise uses the local database.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
if command -v docker >/dev/null 2>&1 && docker compose -f "$ROOT/docker-compose.yml" ps --status running --services 2>/dev/null | grep -qx api; then
  docker compose -f "$ROOT/docker-compose.yml" exec -T api python -m app.seed --reset
  exit 0
fi
cd "$ROOT/services/api"
export PYTHONPATH=.
export DATABASE_URL="${DATABASE_URL:-postgresql+psycopg://acme:acme@localhost:5432/procurement}"
python -m app.seed --reset
